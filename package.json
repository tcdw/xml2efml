{
  "name": "xml2efml",
  "version": "2.0.1",
  "description": "Convert existing XML/HTML to EFML",
  "type": "module",
  "main": "./xml2efml.cjs",
  "module": "./xml2efml.js",
  "types": "./xml2efml.d.ts",
  "exports": {
    "import": {
      "types": "./xml2efml.d.ts",
      "default": "./xml2efml.js"
    },
    "require": {
      "types": "./xml2efml.d.cts",
      "default": "./xml2efml.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tcdw/xml2efml.git"
  },
  "author": "tcdw <tcdw2011@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tcdw/xml2efml/issues"
  },
  "homepage": "https://github.com/tcdw/xml2efml#readme",
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jsdom": "^24.1.1"
  }
}
